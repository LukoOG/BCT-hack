# Copy to .env and fill in (never commit .env)

# LLM provider: groq (default) | anthropic
LLM_PROVIDER=groq
GROQ_API_KEY=gsk_...

# Optional — only if LLM_PROVIDER=anthropic
# ANTHROPIC_API_KEY=sk-ant-...

# Override model (optional)
# LLM_MODEL=llama-3.3-70b-versatile

# Embeddings: tfidf (default, offline) | sentence-transformers (needs torch + Wi-Fi once)
# EMBEDDING_BACKEND=tfidf

# Streamlit API tab — default local FastAPI
# API_BASE_URL=http://127.0.0.1:8000
